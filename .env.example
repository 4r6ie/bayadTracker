# Copy this file to `.env.local` (git-ignored) and fill in your project's
# values from Supabase: Project Settings -> API Keys / Data API.
#
# Leave them unset to run the app local-only (no sign-in, no sync).
#
# The publishable key is safe to ship in the app: row level security in
# supabase/schema.sql is what protects the data. Never put the secret /
# service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
